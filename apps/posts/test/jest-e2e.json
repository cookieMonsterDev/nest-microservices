{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "extensionsToTreatAsEsm": [".ts"],
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "useESM": true }]
  },
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1",
    "^@libs/prisma(|/.*?)(?:\\.js)?$": "<rootDir>/../../../libs/prisma/src/$1",
    "^@libs/kafka(|/.*?)(?:\\.js)?$": "<rootDir>/../../../libs/kafka/src/$1",
    "^@libs/common(|/.*?)(?:\\.js)?$": "<rootDir>/../../../libs/common/src/$1",
    "^@users-micros/test/(.*?)(?:\\.js)?$": "<rootDir>/../../users/test/$1",
    "^@users-micros/(.*?)(?:\\.js)?$": "<rootDir>/../../users/src/$1",
    "^@posts-micros/test/(.*?)(?:\\.js)?$": "<rootDir>/$1",
    "^@posts-micros/(.*?)(?:\\.js)?$": "<rootDir>/../src/$1"
  }
}
